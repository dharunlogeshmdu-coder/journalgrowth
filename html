/* ── AUTO MOOD THEME (based on recent PnL + emotion tags) ── */
const POSITIVE_EMOTIONS=['Calm','Confident','Disciplined','Patient','Focused'];
const NEGATIVE_EMOTIONS=['FOMO','Greedy','Fearful','Anxious','Revenge','Impulsive','Hesitant','Overconfident','Bored','Frustrated','Euphoric','Regretful','Complacent','Stressed','Impatient','Distracted'];
const MOOD_THEMES={
  lockedIn:{vars:{'--accent':'#10b981','--accent2':'#00d4ff','--glow':'0 0 30px rgba(16,185,129,0.2)','--glow2':'0 0 40px rgba(0,212,255,0.12)','--mood-tint1':'rgba(16,185,129,0.08)','--mood-tint2':'rgba(0,212,255,0.05)'},label:'🟢 Locked In',cls:'mood-locked-in'},
  momentum:{vars:{'--accent':'#00d4ff','--accent2':'#10b981','--glow':'0 0 30px rgba(0,212,255,0.18)','--glow2':'0 0 40px rgba(16,185,129,0.1)','--mood-tint1':'rgba(0,212,255,0.07)','--mood-tint2':'rgba(16,185,129,0.05)'},label:'📈 Building Momentum',cls:'mood-momentum'},
  neutral:{vars:{'--accent':'#00d4ff','--accent2':'#7c3aff','--glow':'0 0 30px rgba(0,212,255,0.15)','--glow2':'0 0 40px rgba(124,58,255,0.12)','--mood-tint1':'rgba(124,58,255,0.08)','--mood-tint2':'rgba(0,212,255,0.04)'},label:'◈ Neutral',cls:'mood-neutral'},
  shaky:{vars:{'--accent':'#fb923c','--accent2':'#fbbf24','--glow':'0 0 30px rgba(251,146,60,0.2)','--glow2':'0 0 40px rgba(251,191,36,0.12)','--mood-tint1':'rgba(251,146,60,0.08)','--mood-tint2':'rgba(251,191,36,0.05)'},label:'🟡 Shaky Ground',cls:'mood-shaky'},
  tilt:{vars:{'--accent':'#f43f5e','--accent2':'#fb923c','--glow':'0 0 30px rgba(244,63,94,0.25)','--glow2':'0 0 40px rgba(251,146,60,0.14)','--mood-tint1':'rgba(244,63,94,0.1)','--mood-tint2':'rgba(251,146,60,0.05)'},label:'🔴 Tilt Risk',cls:'mood-tilt'}
};
function computeMood(){
  if(!trades.length) return {key:'neutral',reason:'No trades logged yet.'};
  const recent=[...trades].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,10);
  const netPnL=recent.reduce((s,t)=>s+(t.pnl||0),0);
  let posCount=0,negCount=0,revengeCount=0;
  recent.forEach(t=>{
    if(POSITIVE_EMOTIONS.includes(t.emotion)) posCount++;
    if(NEGATIVE_EMOTIONS.includes(t.emotion)) negCount++;
    if(t.emotion==='Revenge') revengeCount++;
  });
  const pnlScore=netPnL>0?1:netPnL<0?-1:0;
  const emoScore=posCount>negCount?1:negCount>posCount?-1:0;
  const total=pnlScore+emoScore;
  const reason=`Last ${recent.length} trades: net ${netPnL>=0?'+':''}${fmtINR(netPnL)}, ${posCount} calm/disciplined tags vs ${negCount} tilt-risk tags.`;
  let key;
  if(revengeCount>0 && netPnL<0) key='tilt';
  else if(total>=2) key='lockedIn';
  else if(total===1) key='momentum';
  else if(total===0) key='neutral';
  else if(total===-1) key='shaky';
  else key='tilt';
  return {key,reason};
}
function applyMoodTheme(){
  const {key,reason}=computeMood();
  const theme=MOOD_THEMES[key];
  const root=document.documentElement;
  Object.entries(theme.vars).forEach(([k,v])=>root.style.setProperty(k,v));
  document.body.className=(document.body.className||'').replace(/mood-\S+/g,'').trim();
  document.body.classList.add(theme.cls);
  const badge=document.getElementById('mood-badge');
  if(badge){
    badge.textContent=theme.label;
    badge.className='badge mood-badge '+theme.cls;
    badge.title=reason;
  }
}
