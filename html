function addTrade(){
  const date=document.getElementById('f-date').value;
  let symbol=document.getElementById('f-symbol').value;
  if(symbol==='__custom__') symbol=document.getElementById('f-custom-sym').value.trim().toUpperCase();
  const direction=document.getElementById('f-direction').value;
  const capital=document.getElementById('f-capital').value;
  const pnlRaw=document.getElementById('f-pnl').value;
  const qty=document.getElementById('f-qty').value||1;
  const entryTime=document.getElementById('f-entry-time').value;
  const exitTime=document.getElementById('f-exit-time').value;
  const setup=document.getElementById('f-setup').value.trim();
  const emotion=document.getElementById('f-emotion').value;
  const notes=document.getElementById('f-notes').value.trim();

  if(!date||!symbol||capital===''||pnlRaw===''){showToast('Fill Date, Symbol, Capital & P/L',true);return;}

  if(lockedDateVal()===date){
    showToast('Trading is locked for '+date+' — you chose discipline. Unlock it first if you really must.', true);
    return;
  }

  const trade={
    id:Date.now(), date, symbol, direction,
    capital:+capital, pnl:+pnlRaw, qty:+qty,
    entryTime, exitTime,
    setup, emotion, notes,
    ssBefore:ssTemp.before, ssAfter:ssTemp.after
  };
  trades.unshift(trade);
  save(); renderAll(); clearForm();
  showToast('Trade saved ✓');

  const countToday = tradesOnDate(date).length;
  updateTodayCounter(); checkLockState();
  if(countToday>2){
    setTimeout(()=>showDisciplineModal(date), 350);
  }
}

