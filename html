// ════ SCREENSHOTS ════
function ssToPreview(slot, dataUrl, isEdit=false){
  const prefix = isEdit ? 'edit-' : '';
  const prev = document.getElementById(prefix+'prev-'+slot);
  const txt = document.getElementById(prefix+'prev-'+slot+'-txt');
  if(txt) txt.style.display='none';
  // remove old img
  const oldImg = prev.querySelector('img');
  if(oldImg) oldImg.remove();
  const img = document.createElement('img');
  img.src = dataUrl; img.alt = slot;
  prev.appendChild(img);
  const rm = document.getElementById(prefix+'rm-'+slot);
  if(rm) rm.style.display='inline-block';
}

function loadSS(slot, input){
  const file=input.files[0]; if(!file) return;
  const reader=new FileReader();
  reader.onload=e=>{ ssTemp[slot]=e.target.result; ssToPreview(slot,e.target.result); };
  reader.readAsDataURL(file);
}
function clearSS(slot){
  ssTemp[slot]='';
  const prev=document.getElementById('prev-'+slot);
  const oldImg=prev.querySelector('img'); if(oldImg)oldImg.remove();
  const txt=document.getElementById('prev-'+slot+'-txt'); if(txt)txt.style.display='';
  document.getElementById('rm-'+slot).style.display='none';
  document.getElementById('file-'+slot).value='';
}

function loadEditSS(slot, input){
  const file=input.files[0]; if(!file) return;
  const reader=new FileReader();
  reader.onload=e=>{ editTemp[slot]=e.target.result; ssToPreview(slot,e.target.result,true); };
  reader.readAsDataURL(file);
}
function clearEditSS(slot){
  editTemp[slot]='';
  const prev=document.getElementById('edit-prev-'+slot);
  const oldImg=prev.querySelector('img'); if(oldImg)oldImg.remove();
  const txt=document.getElementById('edit-prev-'+slot+'-txt'); if(txt)txt.style.display='';
  document.getElementById('edit-rm-'+slot).style.display='none';
  document.getElementById('edit-file-'+slot).value='';
}

// Drag and drop
function handleDragOver(e, slot){
  e.preventDefault();
  const id = slot.startsWith('edit-') ? 'edit-prev-'+slot.replace('edit-','') : 'prev-'+slot;
  document.getElementById(id).classList.add('dragover');
}
function handleDragLeave(e, slot){
  const id = slot.startsWith('edit-') ? 'edit-prev-'+slot.replace('edit-','') : 'prev-'+slot;
  document.getElementById(id).classList.remove('dragover');
}
function handleDrop(e, slot){
  e.preventDefault();
  const isEdit = slot.startsWith('edit-');
  const realSlot = isEdit ? slot.replace('edit-','') : slot;
  const id = isEdit ? 'edit-prev-'+realSlot : 'prev-'+slot;
  document.getElementById(id).classList.remove('dragover');
  const file = e.dataTransfer.files[0];
  if(!file||!file.type.startsWith('image/')) return;
  const reader=new FileReader();
  reader.onload=ev=>{
    if(isEdit){ editTemp[realSlot]=ev.target.result; ssToPreview(realSlot,ev.target.result,true); }
    else { ssTemp[slot]=ev.target.result; ssToPreview(slot,ev.target.result); }
  };
  reader.readAsDataURL(file);
}

// Global paste handler
document.addEventListener('paste', function(e){
  const items = (e.clipboardData||window.clipboardData).items;
  let imgItem = null;
  for(let item of items){ if(item.type.startsWith('image/')){ imgItem=item; break; } }
  if(!imgItem) return;
  const file = imgItem.getAsFile();
  if(!file) return;
  const reader = new FileReader();
  reader.onload = ev => {
    const dataUrl = ev.target.result;
    if(editModalOpen){
      // paste into edit modal active slot
      editTemp[activeEditPasteSlot] = dataUrl;
      ssToPreview(activeEditPasteSlot, dataUrl, true);
      showToast('Screenshot pasted into edit modal ✓');
    } else {
      ssTemp[activePasteSlot] = dataUrl;
      ssToPreview(activePasteSlot, dataUrl, false);
      const ps = document.getElementById('paste-status');
      ps.style.display='inline'; setTimeout(()=>ps.style.display='none', 2000);
    }
  };
  reader.readAsDataURL(file);
});

