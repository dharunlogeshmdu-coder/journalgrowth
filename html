function renderAnalyticsInsight(setupRows, emotionRows, weekdayRows, dirData){
  const el=document.getElementById('analytics-insight');
  const txt=document.getElementById('analytics-insight-text');
  const insights=[];
  if(setupRows.length>1){
    const best=setupRows[0], worst=setupRows[setupRows.length-1];
    if(best.total>0) insights.push(`Your strongest setup is <b>${best.name}</b> (${fmtINR(best.total)} total, ${best.winRate.toFixed(0)}% win rate).`);
    if(worst.total<0) insights.push(`<b>${worst.name}</b> is your biggest drag (${fmtINR(worst.total)}) — consider cutting it or trading it smaller.`);
  }
  const badEmotion=emotionRows.find(r=>['Revenge','FOMO','Greedy','Anxious','Fearful','Impulsive','Hesitant','Overconfident','Bored','Frustrated','Euphoric','Regretful','Complacent','Stressed','Impatient','Distracted'].includes(r.name) && r.total<0);
  if(badEmotion) insights.push(`Trades tagged <b>${badEmotion.name}</b> have cost you ${fmtINR(badEmotion.total)} — that emotion is a signal to pause, not to trade.`);
  if(weekdayRows.length>1){
    const worstDay=weekdayRows[weekdayRows.length-1];
    if(worstDay.total<0) insights.push(`<b>${worstDay.name}</b>s have been your weakest day (${fmtINR(worstDay.total)}) — worth a closer look.`);
  }
  if(dirData.length===2){
    const diff=Math.abs(dirData[0].val-dirData[1].val);
    if(diff>20) insights.push(`Big gap between Long and Short win rates (${diff.toFixed(0)}pt) — you may have a directional bias worth respecting.`);
  }
  if(insights.length){
    el.style.display='flex';
    txt.innerHTML=insights.join(' ');
  } else {
    el.style.display='none';
  }
}

function renderAnalytics(){
  const cp=v=>v>=0?'var(--accent)':'var(--red)';
  renderBars('setup-bars',groupPnL('setup'),cp);
  renderBars('emotion-bars',groupPnL('emotion'),cp);

  const charge=brokerCharge();
  const gp=trades.filter(t=>t.pnl>0).reduce((s,t)=>s+t.pnl,0);
  const gl=trades.filter(t=>t.pnl<0).reduce((s,t)=>s+t.pnl,0);
  const netPnl=gp+gl-trades.length*charge;
  const totalCap=totalCapital();
  const roc=totalCap?(netPnl/totalCap*100).toFixed(2)+'%':'—';
  document.getElementById('ov-profit').textContent=fmtINR(gp);
  document.getElementById('ov-loss').textContent=fmtINR(gl);
  const ne=document.getElementById('ov-net'); ne.textContent=fmtINR(netPnl); ne.className='ov-val '+(netPnl>0?'up':netPnl<0?'down':'neutral');
  const re=document.getElementById('ov-roc'); re.textContent=roc; re.className='ov-val '+(netPnl>0?'up':netPnl<0?'down':'neutral');

  const dirs={};
  trades.forEach(t=>{const d=t.direction;if(!dirs[d])dirs[d]={wins:0,total:0};dirs[d].total++;if(t.pnl>0)dirs[d].wins++;});
  const dirData=Object.entries(dirs).map(([key,v])=>({key,val:v.total?(v.wins/v.total*100):0}));
  const dEl=document.getElementById('dir-bars');
  if(!dirData.length)dEl.innerHTML='<p style="color:var(--muted);font-size:12px">No data</p>';
  else dEl.innerHTML=dirData.map(d=>`<div class="bar-row">
    <div class="bar-label">${d.key}</div>
    <div class="bar-track"><div class="bar-fill" style="width:${d.val.toFixed(0)}%;background:${d.val>=50?'var(--accent)':'var(--red)'}"></div></div>
    <div class="bar-val">${d.val.toFixed(0)}%</div>
  </div>`).join('');

  const symMap={};
  trades.forEach(t=>{symMap[t.symbol]=(symMap[t.symbol]||0)+1;});
  const symData=Object.entries(symMap).map(([k,v])=>({key:k,val:v})).sort((a,b)=>b.val-a.val);
  const sMax=symData.length?symData[0].val:1;
  document.getElementById('sym-bars').innerHTML=symData.slice(0,8).map(d=>`<div class="bar-row">
    <div class="bar-label">${d.key}</div>
    <div class="bar-track"><div class="bar-fill" style="width:${(d.val/sMax*100).toFixed(0)}%;background:var(--blue)"></div></div>
    <div class="bar-val">${d.val} trades</div>
  </div>`).join('');

  const setupRows=groupStats('setup');
  const emotionRows=groupStats('emotion');
  const weekdayRows=weekdayStats();
  renderPerfTable('setup-perf-table', setupRows);
  renderPerfTable('emotion-perf-table', emotionRows);
  renderPerfTable('weekday-perf-table', weekdayRows);
  renderFeeImpact();
  renderAnalyticsInsight(setupRows, emotionRows, weekdayRows, dirData);
}

