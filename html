// ════ ANALYTICS ════
function renderBars(id,data,colorFn){
  const el=document.getElementById(id);
  if(!data.length){el.innerHTML='<p style="color:var(--muted);font-size:12px">No data</p>';return;}
  const max=Math.max(...data.map(d=>Math.abs(d.val)));
  el.innerHTML=data.slice(0,8).map(d=>{
    const pct=max?(Math.abs(d.val)/max*100).toFixed(1):0;
    return `<div class="bar-row">
      <div class="bar-label" title="${d.key}">${d.key.length>10?d.key.slice(0,10)+'…':d.key}</div>
      <div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:${colorFn(d.val)}"></div></div>
      <div class="bar-val">${fmtINR(d.val)}</div>
    </div>`;
  }).join('');
}
function groupPnL(key){
  const map={};
  trades.forEach(t=>{const k=t[key]||'Unknown';if(!map[k])map[k]=0;map[k]+=t.pnl;});
  return Object.entries(map).map(([key,val])=>({key,val})).sort((a,b)=>b.val-a.val);
}
function groupStats(key){
  const map={};
  trades.forEach(t=>{
    const k=(t[key]||'Unknown')||'Unknown';
    if(!map[k])map[k]={count:0,wins:0,total:0};
    map[k].count++; map[k].total+=t.pnl; if(t.pnl>0)map[k].wins++;
  });
  return Object.entries(map).map(([name,v])=>({
    name, count:v.count, winRate:v.count?v.wins/v.count*100:0,
    avg:v.count?v.total/v.count:0, total:v.total
  })).sort((a,b)=>b.total-a.total);
}

function renderPerfTable(id, rows){
  const el=document.getElementById(id);
  if(!rows.length){el.innerHTML='<tr><td style="color:var(--muted);padding:10px 8px">No data yet</td></tr>';return;}
  const bestTotal=Math.max(...rows.map(r=>r.total));
  const worstTotal=Math.min(...rows.map(r=>r.total));
  el.innerHTML=`<tr><th>Name</th><th>Trades</th><th>Win%</th><th>Avg P/L</th><th>Total P/L</th></tr>`+
    rows.map(r=>{
      const cls = r.total===bestTotal && r.total>0 ? 'pf-best' : (r.total===worstTotal && r.total<0 ? 'pf-worst' : '');
      return `<tr>
        <td class="pf-name">${r.name}</td>
        <td>${r.count}</td>
        <td style="color:${r.winRate>=50?'var(--green)':'var(--red)'}">${r.winRate.toFixed(0)}%</td>
        <td style="color:${r.avg>=0?'var(--accent)':'var(--red)'}">${fmtINR(r.avg)}</td>
        <td class="${cls}" style="font-weight:700">${fmtINR(r.total)}</td>
      </tr>`;
    }).join('');
}

const WEEKDAY_NAMES=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
function weekdayStats(){
  const map={};
  trades.forEach(t=>{
    if(!t.date) return;
    const d=new Date(t.date+'T00:00:00');
    const k=WEEKDAY_NAMES[d.getDay()];
    if(!map[k])map[k]={count:0,wins:0,total:0};
    map[k].count++; map[k].total+=t.pnl; if(t.pnl>0)map[k].wins++;
  });
  return WEEKDAY_NAMES.map(name=>{
    const v=map[name]||{count:0,wins:0,total:0};
    return {name, count:v.count, winRate:v.count?v.wins/v.count*100:0, avg:v.count?v.total/v.count:0, total:v.total};
  }).filter(r=>r.count>0).sort((a,b)=>b.total-a.total);
}

function renderFeeImpact(){
  const charge=brokerCharge();
