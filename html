// ════ TIME ════
function stampTime(fieldId){
  const now = new Date();
  const hh = String(now.getHours()).padStart(2,'0');
  const mm = String(now.getMinutes()).padStart(2,'0');
  document.getElementById(fieldId).value = hh+':'+mm;
  calcDuration();
}

function calcDuration(){
  const entry = document.getElementById('f-entry-time').value;
  const exit = document.getElementById('f-exit-time').value;
  document.getElementById('f-duration').textContent = computeDuration(entry, exit);
}

function computeDuration(entry, exit){
  if(!entry || !exit) return '—';
  const [eh,em] = entry.split(':').map(Number);
  const [xh,xm] = exit.split(':').map(Number);
  let mins = (xh*60+xm)-(eh*60+em);
  if(mins < 0) mins += 1440; // overnight
  if(mins === 0) return '0m';
  const h = Math.floor(mins/60);
  const m = mins%60;
  return h>0 ? `${h}h ${m}m` : `${m}m`;
}

