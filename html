    document.getElementById('bc-per').textContent='₹'+charge;
    document.getElementById('bc-total').textContent='₹0';
    document.getElementById('bc-count').textContent='0';
    return;
  }

  const grossProfit=trades.filter(t=>t.pnl>0).reduce((s,t)=>s+t.pnl,0);
  const grossLoss=trades.filter(t=>t.pnl<0).reduce((s,t)=>s+t.pnl,0);
  const totalCharges=n*charge;
  const netPnl=grossProfit+grossLoss-totalCharges;
  const currentCap=totalCap+netPnl;
  const wins=trades.filter(t=>t.pnl>0).length;
  const losses=trades.filter(t=>t.pnl<0).length;
  const wr=((wins/n)*100).toFixed(0);
  const pf=Math.abs(grossLoss)>0?(grossProfit/Math.abs(grossLoss)).toFixed(2):'∞';
  const ret=totalCap?(netPnl/totalCap*100).toFixed(2)+'%':'—';

  const gp=document.getElementById('stat-gprofit');
  gp.textContent=fmtINR(grossProfit); gp.className='stat-value '+(grossProfit>0?'up':'neutral');
  document.getElementById('stat-gprofit-sub').textContent=wins+' winning trades';

  // Update current capital = base + netPnl
  const capEl=document.getElementById('stat-cap');
  capEl.textContent=fmtINR(currentCap);
  capEl.className='stat-value '+(currentCap>totalCap?'up':currentCap<totalCap?'down':'neutral');
  document.getElementById('stat-cap-sub').textContent='Base: '+fmtINR(totalCap)+(netPnl>=0?' +':' ')+fmtINR(netPnl).replace('₹','')+' P&L';

  const gl=document.getElementById('stat-gloss');
  gl.textContent=fmtINR(grossLoss); gl.className='stat-value '+(grossLoss<0?'down':'neutral');
  document.getElementById('stat-gloss-sub').textContent=losses+' losing trades';

  document.getElementById('stat-charges').textContent=fmtINR(totalCharges);

  const pe=document.getElementById('stat-pnl');
  pe.textContent=fmtINR(netPnl); pe.className='stat-value '+(netPnl>0?'up':netPnl<0?'down':'neutral');

  const we=document.getElementById('stat-wr');
  we.textContent=wr+'%'; we.className='stat-value '+(+wr>=50?'up':'down');
  document.getElementById('stat-wl').textContent=wins+'W / '+losses+'L';
  document.getElementById('stat-pf').textContent=pf;
  const re=document.getElementById('stat-ret');
  re.textContent=ret; re.className='stat-value '+(netPnl>0?'up':netPnl<0?'down':'neutral');

  document.getElementById('bc-per').textContent='₹'+charge;
  document.getElementById('bc-total').textContent=fmtINR(totalCharges);
  document.getElementById('bc-count').textContent=n;
}

// ════ TABLE ════
function renderTable(){
  const dirF=document.getElementById('filter-dir').value;
  const resF=document.getElementById('filter-result').value;
  const symF=document.getElementById('filter-sym').value.toUpperCase();
  const charge=brokerCharge();

  let filtered=trades.filter(t=>{
    const result=calcResult(t.pnl);
    return(!dirF||t.direction===dirF)&&(!resF||result===resF)&&(!symF||t.symbol.includes(symF));
  });

  const tbody=document.getElementById('trade-tbody');
  const tfoot=document.getElementById('trade-tfoot');
  const empty=document.getElementById('empty-msg');

  if(!filtered.length){tbody.innerHTML='';tfoot.innerHTML='';empty.style.display='';return;}
  empty.style.display='none';

  let sumCap=0,sumGross=0,sumNet=0;

  function tradeRowHtml(t){
    const net=t.pnl-charge;
    const pct=t.capital?((net/t.capital)*100).toFixed(2):'—';
    const result=calcResult(t.pnl);
    const resChip=result==='Win'?'win':result==='Loss'?'loss':'be';
    const dirChip=t.direction==='Long'?'long':'short';
    const pnlCls=t.pnl>0?'pnl-pos':t.pnl<0?'pnl-neg':'';
    const netCls=net>0?'pnl-pos':net<0?'pnl-neg':'';
    sumCap+=t.capital||0; sumGross+=t.pnl; sumNet+=net;
    const dur=computeDuration(t.entryTime,t.exitTime);

    let ssHtml='—';
    if(t.ssBefore||t.ssAfter){
      ssHtml='';
      if(t.ssBefore) ssHtml+=`<img class="ss-thumb" src="${t.ssBefore}" title="Before" onclick="viewSS(${t.id})"/>`;
      if(t.ssAfter)  ssHtml+=`<img class="ss-thumb" src="${t.ssAfter}" title="After" onclick="viewSS(${t.id})" style="margin-left:3px"/>`;
    }

    const entryDisp=t.entryTime||'—';
    const exitDisp=t.exitTime||'—';

    return `<tr data-id="${t.id}">
      <td>${t.date}</td>
      <td><b>${t.symbol}</b></td>
      <td><span class="chip ${dirChip}">${t.direction}</span></td>
      <td style="color:var(--muted)">${entryDisp}</td>
      <td style="color:var(--muted)">${exitDisp}</td>
      <td>${dur!=='—'?`<span class="dur-chip">${dur}</span>`:'—'}</td>
      <td>${fmtINR(t.capital||0)}</td>
      <td class="${pnlCls}">${fmtSgn(t.pnl)}</td>
      <td style="color:var(--amber)">-₹${charge}</td>
      <td class="${netCls}">${fmtSgn(net)}</td>
      <td style="color:var(--muted)">${pct==='—'?'—':pct+'%'}</td>
      <td><span class="chip ${resChip}">${result}</span></td>
      <td style="color:var(--muted);font-size:11px">${t.setup||'—'}</td>
      <td style="color:var(--muted);font-size:11px">${t.emotion||'—'}</td>
      <td>${ssHtml}</td>
      <td style="white-space:nowrap">
        <button class="action-btn edt" title="Edit" onclick="openEdit(${t.id})">✏️</button>
        <button class="action-btn del" title="Delete" onclick="deleteTrade(${t.id})">🗑</button>
      </td>
    </tr>`;
  }

  // Group filtered trades by date (most recent day first), each day gets
  // a title row with the date, weekday name, and that day's totals.
  const byDate={};
  filtered.forEach(t=>{ (byDate[t.date]=byDate[t.date]||[]).push(t); });
  const dateKeys=Object.keys(byDate).sort((a,b)=>b.localeCompare(a));

  tbody.innerHTML=dateKeys.map(dateStr=>{
    const dayTrades=byDate[dateStr];
    const dayGross=dayTrades.reduce((s,t)=>s+t.pnl,0);
    const dayNet=dayGross-dayTrades.length*charge;
    const dObj=new Date(dateStr+'T00:00:00');
    const dayName=isNaN(dObj)?'':dObj.toLocaleDateString('en-IN',{weekday:'long'});
    const dateDisp=isNaN(dObj)?dateStr:dObj.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'});
    const dayNetCls=dayNet>0?'pnl-pos':dayNet<0?'pnl-neg':'';
    const headerRow=`<tr class="day-header-row"><td colspan="16">
        <div class="day-header">
          <div class="day-header-left">
            <span class="day-title">${dateDisp}</span>
            <span class="day-name">${dayName}</span>
          </div>
          <div class="day-header-right">
            <span class="day-count">${dayTrades.length} trade${dayTrades.length===1?'':'s'}</span>
            <span class="day-net ${dayNetCls}">${fmtSgn(dayNet)}</span>
          </div>
        </div>
      </td></tr>`;
    return headerRow + dayTrades.map(tradeRowHtml).join('');
  }).join('');

  const totalChargesFilt=filtered.length*charge;
  const sumNetCls=sumNet>0?'pnl-pos':sumNet<0?'pnl-neg':'';
  tfoot.innerHTML=`<tr class="summary-row">
    <td colspan="6" style="font-size:11px;color:var(--muted)">TOTAL (${filtered.length} trades)</td>
    <td>${fmtINR(sumCap)}</td>
    <td class="${sumGross>0?'pnl-pos':sumGross<0?'pnl-neg':''}">${fmtSgn(sumGross)}</td>
    <td style="color:var(--amber)">-₹${totalChargesFilt}</td>
    <td class="${sumNetCls}">${fmtSgn(sumNet)}</td>
    <td colspan="6"></td>
  </tr>`;
}

