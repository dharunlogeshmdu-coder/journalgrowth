function buildJournalContext(){
  const charge = brokerCharge();
  const totalCap = totalCapital();
  const gp = trades.filter(t=>t.pnl>0).reduce((s,t)=>s+t.pnl,0);
  const gl = trades.filter(t=>t.pnl<0).reduce((s,t)=>s+t.pnl,0);
  const totalCharges = trades.length * charge;
  const netPnl = gp + gl - totalCharges;
  const wins = trades.filter(t=>t.pnl>0).length;
  const losses = trades.filter(t=>t.pnl<0).length;
  const wr = trades.length ? ((wins/trades.length)*100).toFixed(1) : 0;
  const pf = Math.abs(gl)>0 ? (gp/Math.abs(gl)).toFixed(2) : 'inf';
  const avgWin = wins ? (gp/wins).toFixed(0) : 0;
  const avgLoss = losses ? (gl/losses).toFixed(0) : 0;
  const rr = (avgLoss && avgWin) ? (Math.abs(avgWin/avgLoss)).toFixed(2) : 'N/A';

  // Emotion stats
  const emotionMap = {};
  trades.forEach(t=>{
    if(t.emotion){ if(!emotionMap[t.emotion])emotionMap[t.emotion]={count:0,pnl:0}; emotionMap[t.emotion].count++; emotionMap[t.emotion].pnl+=t.pnl; }
  });
  const emotionStr = Object.entries(emotionMap).map(([e,v])=>`${e}: ${v.count} trades, net PnL Rs.${v.pnl.toFixed(0)}`).join('; ');

  // Setup stats
  const setupMap = {};
  trades.forEach(t=>{
    if(t.setup){ if(!setupMap[t.setup])setupMap[t.setup]={count:0,pnl:0}; setupMap[t.setup].count++; setupMap[t.setup].pnl+=t.pnl; }
  });
  const setupStr = Object.entries(setupMap).map(([s,v])=>`${s}: ${v.count} trades, net PnL Rs.${v.pnl.toFixed(0)}`).join('; ');

  // Symbol stats
  const symMap = {};
  trades.forEach(t=>{ if(!symMap[t.symbol])symMap[t.symbol]={count:0,pnl:0}; symMap[t.symbol].count++; symMap[t.symbol].pnl+=t.pnl; });
  const symStr = Object.entries(symMap).sort((a,b)=>b[1].count-a[1].count).slice(0,8).map(([s,v])=>`${s}: ${v.count} trades, PnL Rs.${v.pnl.toFixed(0)}`).join('; ');

  // Recent 10 trades
  const recent = [...trades].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,10).map(t=>
    `${t.date} ${t.symbol} ${t.direction} PnL:Rs.${t.pnl} Capital:Rs.${t.capital||0}${t.emotion?' Emotion:'+t.emotion:''}${t.setup?' Setup:'+t.setup:''}`
  ).join('\n');

  // Streak
  const sorted = [...trades].sort((a,b)=>a.date.localeCompare(b.date));
  let curStreak=0, maxWin=0, maxLoss=0, cur=0;
  sorted.forEach(t=>{ if(t.pnl>0){cur=cur>0?cur+1:1;}else{cur=cur<0?cur-1:-1;} if(cur>maxWin)maxWin=cur; if(cur<maxLoss)maxLoss=cur; });

  return `DHARUN RECORDS — TRADING JOURNAL DATA
==================================
Capital: Rs.${totalCap.toLocaleString('en-IN')}
Current Capital (after PnL): Rs.${(totalCap+netPnl).toLocaleString('en-IN')}
Total Trades: ${trades.length}
Gross Profit: Rs.${gp.toFixed(0)} | Gross Loss: Rs.${gl.toFixed(0)}
Broker Charges Total: Rs.${totalCharges}
Net PnL: Rs.${netPnl.toFixed(0)}
Win Rate: ${wr}% (${wins}W / ${losses}L)
Profit Factor: ${pf}
Avg Win: Rs.${avgWin} | Avg Loss: Rs.${avgLoss}
Reward:Risk Ratio: ${rr}
Max Win Streak: ${maxWin} | Max Loss Streak: ${Math.abs(maxLoss)}
Net Return on Capital: ${totalCap?(netPnl/totalCap*100).toFixed(2):0}%

EMOTION BREAKDOWN: ${emotionStr||'No emotion data'}
SETUP BREAKDOWN: ${setupStr||'No setup data'}
SYMBOL BREAKDOWN: ${symStr||'No symbol data'}

RECENT 10 TRADES:
${recent||'No trades yet'}`;
}


// ════ CALENDAR ════
let calYear = new Date().getFullYear();
let calMonth = new Date().getMonth(); // 0-indexed

function renderCalendar(){
  const today = new Date();
  const todayStr = today.toISOString().split('T')[0];
  const charge = brokerCharge();

  // Build daily trade map
  const dayMap = {};
  trades.forEach(t => {
    if(!dayMap[t.date]) dayMap[t.date] = [];
    dayMap[t.date].push(t);
  });

  const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  document.getElementById('cal-month-title').textContent = MONTHS[calMonth] + ' ' + calYear;

  const firstDay = new Date(calYear, calMonth, 1);
  const lastDay  = new Date(calYear, calMonth+1, 0);
  // Start from Sunday (0) of the week containing the 1st
  let startDate = new Date(firstDay);
  startDate.setDate(startDate.getDate() - startDate.getDay());

  const DAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  let html = DAYS.map(d=>`<div class="cal-header-cell">${d}</div>`).join('');

  let cur = new Date(startDate);
  // We need enough rows to cover the month
  const totalCells = Math.ceil((firstDay.getDay() + lastDay.getDate()) / 7) * 7;

  for(let i = 0; i < totalCells; i++){
    const dateStr = cur.toISOString().split('T')[0];
    const dayTrades = dayMap[dateStr] || [];
    const isThisMonth = cur.getMonth() === calMonth;
    const isToday = dateStr === todayStr;

    let classes = 'cal-cell';
    if(dayTrades.length) classes += ' has-trades';
    if(!isThisMonth) classes += ' other-month';
    if(isToday) classes += ' today';

    let innerHtml = `<div class="cal-date-num">${cur.getDate()}</div>`;

    if(dayTrades.length > 0){
      const dayPnl = dayTrades.reduce((s,t)=>s+t.pnl, 0);
      const dayNet = dayPnl - dayTrades.length * charge;
      const totalTime = dayTrades.reduce((s,t)=>s+durationMinutes(t.entryTime,t.exitTime),0);
      const totalCap = dayTrades.reduce((s,t)=>s+(t.capital||0),0);
      const pnlClass = dayNet>0?'profit':dayNet<0?'loss':'be';
      const pnlSign = dayNet>=0?'+':'';

      innerHtml += `<div class="cal-pnl-badge ${pnlClass}">${pnlSign}${fmtINR(dayNet)}</div>`;
      if(totalCap>0) innerHtml += `<div class="cal-meta">Cap: ${fmtINR(totalCap)}</div>`;
      if(totalTime>0) innerHtml += `<div class="cal-meta">⏱ ${formatMins(totalTime)}</div>`;

      // Strategy names (unique)
      const setups = [...new Set(dayTrades.map(t=>t.setup).filter(Boolean))];
      if(setups.length) innerHtml += `<div class="cal-strat-tag">${setups.join(', ')}</div>`;

      // Profit border glow
      const borderColor = dayNet>0?'rgba(16,185,129,.4)':dayNet<0?'rgba(244,63,94,.35)':'rgba(251,146,60,.35)';

      html += `<div class="${classes}" style="border-color:${borderColor};background:${dayNet>0?'rgba(16,185,129,.04)':dayNet<0?'rgba(244,63,94,.04)':'var(--surface)'}" onclick="openCalPopup('${dateStr}')">${innerHtml}</div>`;
    } else {
      html += `<div class="${classes}">${innerHtml}</div>`;
    }
    cur.setDate(cur.getDate()+1);
  }

  document.getElementById('cal-grid').innerHTML = html;
}

function durationMinutes(entry, exit){
  if(!entry||!exit) return 0;
  const [eh,em] = entry.split(':').map(Number);
  const [xh,xm] = exit.split(':').map(Number);
  let mins = (xh*60+xm)-(eh*60+em);
  if(mins<0) mins+=1440;
  return mins;
}

function formatMins(mins){
  if(!mins) return '0m';
  const h = Math.floor(mins/60);
  const m = mins%60;
  return h>0?`${h}h ${m}m`:`${m}m`;
}

function calNav(dir){
  calMonth += dir;
  if(calMonth > 11){ calMonth=0; calYear++; }
  if(calMonth < 0){ calMonth=11; calYear--; }
  renderCalendar();
}

function calToday(){
  const now = new Date();
  calYear = now.getFullYear();
  calMonth = now.getMonth();
  renderCalendar();
}

function openCalPopup(dateStr){
  const dayTrades = trades.filter(t=>t.date===dateStr);
  if(!dayTrades.length) return;
  const charge = brokerCharge();

  // Format date nicely
  const [y,m,d] = dateStr.split('-').map(Number);
  const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const DAYS_LONG = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const dateObj = new Date(y,m-1,d);
  document.getElementById('cal-popup-date').textContent = `📅 ${DAYS_LONG[dateObj.getDay()]}, ${d} ${MONTHS[m-1]} ${y}`;

  const totalGross = dayTrades.reduce((s,t)=>s+t.pnl,0);
  const totalNet = totalGross - dayTrades.length*charge;
  const totalTime = dayTrades.reduce((s,t)=>s+durationMinutes(t.entryTime,t.exitTime),0);
  const totalCap = dayTrades.reduce((s,t)=>s+(t.capital||0),0);
  const wins = dayTrades.filter(t=>t.pnl>0).length;
  const losses = dayTrades.filter(t=>t.pnl<0).length;

  const netColor = totalNet>0?'var(--green)':totalNet<0?'var(--red)':'var(--amber)';
  const netSign = totalNet>=0?'+':'';

  document.getElementById('cal-popup-summary').innerHTML = `
    <div class="cal-popup-stat">
      <div class="cal-popup-stat-label">Net P&L</div>
      <div class="cal-popup-stat-val" style="color:${netColor}">${netSign}${fmtINR(totalNet)}</div>
    </div>
    <div class="cal-popup-stat">
      <div class="cal-popup-stat-label">Capital Used</div>
      <div class="cal-popup-stat-val" style="color:var(--accent)">${fmtINR(totalCap)}</div>
    </div>
    <div class="cal-popup-stat">
      <div class="cal-popup-stat-label">Time in Market</div>
      <div class="cal-popup-stat-val" style="color:var(--amber)">${formatMins(totalTime)||'—'}</div>
    </div>
    <div class="cal-popup-stat">
      <div class="cal-popup-stat-label">Trades</div>
      <div class="cal-popup-stat-val" style="color:var(--text)">${dayTrades.length}</div>
    </div>
    <div class="cal-popup-stat">
      <div class="cal-popup-stat-label">Win / Loss</div>
      <div class="cal-popup-stat-val" style="color:var(--text)">${wins}W / ${losses}L</div>
    </div>
    <div class="cal-popup-stat">
      <div class="cal-popup-stat-label">Broker Charges</div>
      <div class="cal-popup-stat-val" style="color:var(--amber)">-${fmtINR(dayTrades.length*charge)}</div>
    </div>
  `;

  const tradesHtml = dayTrades.map(t => {
    const net = t.pnl - charge;
    const netCls = net>0?'var(--green)':net<0?'var(--red)':'var(--amber)';
    const pnlLabel = t.pnl>=0?'P':'L';
    const pnlSign = t.pnl>=0?'+':'';
    const dirChip = t.direction==='Long'?'long':'short';
    const resCls = t.pnl>0?'win':t.pnl<0?'loss':'be';
    const dur = computeDuration(t.entryTime, t.exitTime);
    return `
    <div class="cal-trade-card">
      <div class="cal-trade-header">
        <div class="cal-trade-sym">${t.symbol}</div>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
          <span class="chip ${dirChip}">${t.direction}</span>
          <span class="chip ${resCls}" style="font-size:11px">${pnlLabel}: <span style="color:${netCls};font-weight:800">${pnlSign}${fmtINR(t.pnl)}</span></span>
        </div>
      </div>
      <div class="cal-trade-row">
        ${t.setup?`<span>📐 ${t.setup}</span>`:''}
        ${t.entryTime?`<span>▶ ${t.entryTime}</span>`:''}
        ${t.exitTime?`<span>⏹ ${t.exitTime}</span>`:''}
        ${dur!=='—'?`<span>⏱ ${dur}</span>`:''}
        ${t.capital?`<span>💰 ${fmtINR(t.capital)}</span>`:''}
        <span style="color:${netCls}">Net: ${(net>=0?'+':'')+fmtINR(net)}</span>
        ${t.emotion?`<span>😶 ${t.emotion}</span>`:''}
      </div>
      ${t.notes?`<div style="margin-top:5px;font-size:11px;color:var(--muted);font-family:var(--font-r)">${t.notes}</div>`:''}
    </div>`;
  }).join('');

  document.getElementById('cal-popup-trades').innerHTML = tradesHtml;
  document.getElementById('cal-popup-overlay').classList.add('open');
}

function closeCalPopup(){
  document.getElementById('cal-popup-overlay').classList.remove('open');
}


async function sendAI(){
  const input = document.getElementById('ai-input');
  const msg = input.value.trim();
  if(!msg) return;

  // Append user message
  appendAIMsg(msg, 'user');
  input.value = '';
  input.style.height = 'auto';

  // Hide quick buttons after first use
  document.getElementById('ai-quick-btns').style.display = 'none';

  // Disable send
  const btn = document.getElementById('ai-send-btn');
  btn.disabled = true;

  // Show typing indicator
  const typingId = showTyping();

  // Build message history
  aiHistory.push({role:'user', content: msg});

  const systemPrompt = `You are an expert trading coach and risk advisor for Dharun Records, a personal trading journal app. You have full access to the user's trading journal data below. Your job is to give specific, honest, actionable advice about their trading — performance, risk management, psychology, patterns, and improvement areas.

Be direct and specific. Reference their actual numbers, trades, emotions, and setups. Don't be vague. If they're losing, say so clearly and explain why based on their data. If they're doing well, highlight what's working. Focus on risk management, consistency, and trading psychology.

Always structure your response clearly. Use short paragraphs. When giving numbers, be precise. Keep responses concise but insightful (aim for 150-300 words unless a deep analysis is needed).

${buildJournalContext()}`;

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system: systemPrompt,
        messages: aiHistory
      })
    });
    const data = await res.json();
    removeTyping(typingId);

    const reply = data.content?.[0]?.text || 'Sorry, I could not get a response. Please try again.';
    aiHistory.push({role:'assistant', content: reply});
    appendAIMsg(reply, 'bot');
  } catch(e) {
    removeTyping(typingId);
    appendAIMsg('Connection error. Please check your internet and try again.', 'bot');
    aiHistory.pop();
  }
  btn.disabled = false;
}

function appendAIMsg(text, role){
  const container = document.getElementById('ai-messages');
  const div = document.createElement('div');
  div.className = 'ai-msg ' + role;
  const avatar = document.createElement('div');
  avatar.className = 'ai-msg-avatar';
  avatar.textContent = role==='bot' ? '🤖' : '👤';
  const bubble = document.createElement('div');
  bubble.className = 'ai-bubble';
  // Convert **bold** and line breaks
  bubble.innerHTML = text
    .replace(/\*\*(.*?)\*\*/g,'<b>$1</b>')
    .replace(/\n/g,'<br>');
  div.appendChild(avatar);
  div.appendChild(bubble);
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
}

function showTyping(){
  const container = document.getElementById('ai-messages');
  const id = 'typing-'+Date.now();
  const div = document.createElement('div');
  div.className = 'ai-msg bot'; div.id = id;
  div.innerHTML = `<div class="ai-msg-avatar">🤖</div><div class="ai-bubble" style="padding:10px 14px"><div class="ai-typing"><span></span><span></span><span></span></div></div>`;
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
  return id;
}

function removeTyping(id){
  const el = document.getElementById(id);
  if(el) el.remove();
}
