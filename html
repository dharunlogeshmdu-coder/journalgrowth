  const gp=trades.filter(t=>t.pnl>0).reduce((s,t)=>s+t.pnl,0);
  const feePct = gp>0 ? (totalFees/gp*100) : 0;
  const eaten = trades.filter(t=>t.pnl>0 && t.pnl<=charge).length;
  const grid=document.getElementById('fee-impact-grid');
  grid.innerHTML=`
    <div class="fee-stat"><div class="fv" style="color:var(--red)">${fmtINR(totalFees)}</div><div class="fl">Total Fees Paid</div></div>
    <div class="fee-stat"><div class="fv" style="color:${feePct>25?'var(--red)':'var(--amber)'}">${gp>0?feePct.toFixed(1)+'%':'—'}</div><div class="fl">Fees vs Gross Profit</div></div>
    <div class="fee-stat"><div class="fv" style="color:var(--amber)">${eaten}</div><div class="fl">Wins Wiped by Fees</div></div>
    <div class="fee-stat"><div class="fv">${trades.length}</div><div class="fl">Total Trades</div></div>`;
