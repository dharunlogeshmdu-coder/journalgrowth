<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Dharun Records</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Outfit:wght@300;400;500;600;700;800;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#060810;
  --bg2:#090c18;
  --surface:#0e1220;
  --surface2:#131829;
  --surface3:#1a2035;
  --surface4:#1f2640;
  --border:rgba(99,120,255,0.1);
  --border2:rgba(99,120,255,0.2);
  --border3:rgba(99,120,255,0.35);
  --text:#dde4ff;
  --text2:#a8b4d8;
  --muted:#5a6488;
  --accent:#00d4ff;
  --accent2:#7c3aff;
  --accent-dim:rgba(0,212,255,0.1);
  --accent2-dim:rgba(124,58,255,0.1);
  --gold:#fbbf24;
  --gold-dim:rgba(251,191,36,0.12);
  --red:#f43f5e;--red-dim:rgba(244,63,94,0.12);
  --amber:#fb923c;--amber-dim:rgba(251,146,60,0.12);
  --green:#10b981;--green-dim:rgba(16,185,129,0.12);
  --blue:#3b82f6;--blue-dim:rgba(59,130,246,0.1);
  --purple:#a855f7;--purple-dim:rgba(168,85,247,0.12);
  --radius:10px;--radius-lg:16px;--radius-xl:22px;
  --font-d:'Outfit',sans-serif;
  --font-r:'Rajdhani',sans-serif;
  --font-m:'Space Mono',monospace;
  --glow:0 0 30px rgba(0,212,255,0.15);
  --glow2:0 0 40px rgba(124,58,255,0.12);
  --mood-tint1:rgba(124,58,255,0.08);
  --mood-tint2:rgba(0,212,255,0.04);
  --mood-transition:background .8s ease,border-color .8s ease,box-shadow .8s ease,color .8s ease;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--text);font-family:var(--font-m);font-size:13.5px;min-height:100vh;line-height:1.65;background-image:radial-gradient(ellipse 80% 50% at 50% -20%,var(--mood-tint1),transparent),radial-gradient(ellipse 60% 40% at 80% 60%,var(--mood-tint2),transparent);transition:var(--mood-transition)}
.mood-badge{transition:var(--mood-transition);cursor:default}
.mood-badge.mood-tilt{animation:pulseDanger 1.6s ease-in-out infinite}
nav button.active,.stat-card::before,.card::after{transition:var(--mood-transition)}

/* ── HEADER ── */
header{display:flex;align-items:center;justify-content:space-between;padding:.75rem 2rem;border-bottom:1px solid var(--border2);background:rgba(9,12,24,0.92);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);position:sticky;top:0;z-index:50;gap:12px;flex-wrap:wrap}
header::after{content:'';position:absolute;bottom:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--accent),var(--accent2),transparent);opacity:.5}

/* ── LOGO ── */
.logo-wrap{display:flex;align-items:center;gap:12px;text-decoration:none;white-space:nowrap}
.logo-icon{width:38px;height:38px;flex-shrink:0}
.logo-text{display:flex;flex-direction:column;line-height:1.1}
.logo-name{font-family:var(--font-r);font-weight:700;font-size:1.15rem;letter-spacing:2px;color:var(--text);text-transform:uppercase}
.logo-name span{color:var(--accent)}
.logo-sub{font-family:var(--font-m);font-size:9px;color:var(--muted);letter-spacing:3px;text-transform:uppercase}

/* ── NAV ── */
nav{display:flex;gap:2px;flex-wrap:wrap;background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:3px}
nav button{background:none;border:none;cursor:pointer;padding:6px 16px;border-radius:9px;font-family:var(--font-r);font-size:13px;font-weight:600;letter-spacing:.5px;color:var(--muted);transition:all .2s}
nav button:hover{color:var(--text);background:var(--surface3)}
nav button.active{color:#fff;background:linear-gradient(135deg,var(--accent2),var(--accent));box-shadow:0 2px 12px rgba(124,58,255,0.4)}

/* ── HDR RIGHT ── */
.hdr-right{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.badge{font-size:10px;padding:3px 10px;border-radius:20px;background:var(--accent-dim);color:var(--accent);font-family:var(--font-m);white-space:nowrap;border:1px solid rgba(0,212,255,0.25);letter-spacing:.5px}
.btn-pdf{background:linear-gradient(135deg,rgba(59,130,246,0.15),rgba(124,58,255,0.15));border:1px solid var(--border2);color:var(--text2);border-radius:10px;padding:6px 16px;font-family:var(--font-r);font-size:13px;font-weight:600;cursor:pointer;transition:all .2s;letter-spacing:.5px}
.btn-pdf:hover{background:linear-gradient(135deg,var(--blue),var(--accent2));color:#fff;border-color:transparent;box-shadow:0 4px 20px rgba(59,130,246,0.3)}

/* ── MAIN ── */
main{max-width:1400px;margin:0 auto;padding:1.8rem 2rem}

/* ── STAT CARDS ── */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:1.8rem}
.stat-card{background:linear-gradient(135deg,var(--surface) 0%,var(--surface2) 100%);border:1px solid var(--border);border-radius:var(--radius-xl);padding:1.1rem 1.3rem;position:relative;overflow:hidden;transition:border-color .2s,transform .2s}
.stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--accent2),var(--accent));opacity:0;transition:opacity .2s}
.stat-card:hover{border-color:var(--border3);transform:translateY(-2px)}
.stat-card:hover::before{opacity:1}
.stat-card:first-child{border-color:rgba(0,212,255,0.25);background:linear-gradient(135deg,rgba(0,212,255,0.06),var(--surface2))}
.stat-card:first-child::before{opacity:.6}
.stat-label{font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:8px;font-family:var(--font-r);font-weight:600}
.stat-value{font-family:var(--font-d);font-size:1.45rem;font-weight:800;letter-spacing:-.5px}
.stat-value.up{color:var(--green)}.stat-value.down{color:var(--red)}.stat-value.neutral{color:var(--text)}
.stat-sub{font-size:10px;color:var(--muted);margin-top:4px;font-family:var(--font-m)}

/* ── VIEWS ── */
.view{display:none;animation:fadeUp .3s ease}.view.active{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.top-cols{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:1.5rem}
@media(max-width:900px){.top-cols{grid-template-columns:1fr}}

/* ── CARDS ── */
.card{background:linear-gradient(135deg,var(--surface) 0%,var(--surface2) 100%);border:1px solid var(--border);border-radius:var(--radius-xl);padding:1.4rem 1.6rem;margin-bottom:1.4rem;position:relative;overflow:hidden}
.card::after{content:'';position:absolute;top:-60px;right:-60px;width:120px;height:120px;background:radial-gradient(circle,rgba(124,58,255,0.08),transparent);pointer-events:none}
.card-title{font-family:var(--font-d);font-size:.95rem;font-weight:700;color:var(--accent);margin-bottom:1.1rem;display:flex;align-items:center;gap:8px;letter-spacing:-.2px}

/* ── CAP TABLE ── */
.cap-table{width:100%;border-collapse:collapse}
.cap-table th{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:1.2px;padding:6px 10px;border-bottom:1px solid var(--border);text-align:left;font-family:var(--font-r);font-weight:600}
.cap-table td{padding:7px 10px;border-bottom:1px solid var(--border);font-size:13px}
.cap-table tr:last-child td{border-bottom:none}
.cap-table input{background:var(--surface3);border:1px solid var(--border2);border-radius:8px;color:var(--text);font-family:var(--font-m);font-size:12px;padding:5px 9px;width:100%;outline:none;transition:all .15s}
.cap-table input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(0,212,255,0.08)}
.add-row-btn{margin-top:10px;background:none;border:1px dashed var(--border2);color:var(--muted);border-radius:10px;padding:7px 14px;font-family:var(--font-r);font-size:12px;font-weight:600;cursor:pointer;width:100%;transition:all .2s;letter-spacing:.5px}
.add-row-btn:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-dim)}
.broker-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.broker-row label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;white-space:nowrap;font-family:var(--font-r);font-weight:600}
.broker-row input{background:var(--surface3);border:1px solid var(--border2);border-radius:10px;color:var(--text);font-family:var(--font-m);font-size:14px;padding:8px 13px;width:150px;outline:none;transition:all .15s}
.broker-row input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(0,212,255,0.08)}
.broker-note{font-size:10px;color:var(--muted);margin-top:8px;line-height:1.6}

/* ── FORM ── */
.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(148px,1fr));gap:12px;margin-bottom:14px}
.field{display:flex;flex-direction:column;gap:5px}
.field label{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:1.5px;font-family:var(--font-r);font-weight:700}
.field input,.field select,.field textarea{background:var(--surface3);border:1px solid var(--border2);border-radius:var(--radius);color:var(--text);font-family:var(--font-m);font-size:12.5px;padding:8px 12px;outline:none;transition:all .2s}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(0,212,255,0.08),0 0 20px rgba(0,212,255,0.05)}
.field select option{background:var(--surface2)}
.field textarea{resize:vertical;min-height:58px}
.form-actions{display:flex;gap:10px;margin-top:8px;flex-wrap:wrap;align-items:center}
.btn{padding:9px 22px;border-radius:var(--radius);font-family:var(--font-r);font-size:13px;font-weight:700;cursor:pointer;border:none;transition:all .2s;letter-spacing:.5px}
.btn-primary{background:linear-gradient(135deg,var(--accent2),var(--accent));color:#fff;box-shadow:0 4px 20px rgba(124,58,255,0.3)}.btn-primary:hover{transform:translateY(-1px);box-shadow:0 6px 25px rgba(124,58,255,0.45)}
.btn-ghost{background:none;border:1px solid var(--border2);color:var(--muted)}.btn-ghost:hover{color:var(--text);background:var(--surface3);border-color:var(--border3)}
.btn-edit-save{background:var(--green-dim);border:1px solid var(--green);color:var(--green)}.btn-edit-save:hover{background:var(--green);color:#fff}
.time-display{background:var(--surface3);border:1px solid var(--border2);border-radius:var(--radius);padding:8px 12px;font-family:var(--font-m);font-size:12.5px;color:var(--accent);min-height:37px;display:flex;align-items:center}
.duration-display{background:var(--amber-dim);border:1px solid var(--amber);border-radius:var(--radius);padding:8px 12px;font-family:var(--font-m);font-size:12.5px;color:var(--amber);min-height:37px;display:flex;align-items:center}

/* ── DISCIPLINE ── */
.today-counter{display:flex;align-items:center;gap:7px;font-size:11px;font-family:var(--font-r);font-weight:600;letter-spacing:.5px;color:var(--muted);background:var(--surface3);border:1px solid var(--border2);border-radius:20px;padding:5px 12px}
.today-counter.warn{color:var(--amber);border-color:var(--amber);background:var(--amber-dim)}
.today-counter.danger{color:var(--red);border-color:var(--red);background:var(--red-dim);animation:pulseDanger 1.6s ease-in-out infinite}
.today-counter .dot{width:6px;height:6px;border-radius:50%;background:currentColor}
@keyframes pulseDanger{0%,100%{box-shadow:0 0 0 0 rgba(244,63,94,.35)}50%{box-shadow:0 0 0 6px rgba(244,63,94,0)}}

.discipline-overlay{display:none;position:fixed;inset:0;background:rgba(4,2,8,.88);backdrop-filter:blur(10px);z-index:400;align-items:center;justify-content:center;padding:20px}
.discipline-overlay.open{display:flex;animation:fadeUp .25s ease}
.discipline-modal{width:100%;max-width:440px;background:linear-gradient(160deg,rgba(31,9,20,0.97),var(--surface2) 60%);border:1px solid rgba(244,63,94,0.45);border-radius:var(--radius-xl);padding:1.8rem 1.7rem 1.5rem;position:relative;box-shadow:0 0 60px rgba(244,63,94,0.2),0 20px 60px rgba(0,0,0,.5);text-align:center}
.discipline-icon{width:52px;height:52px;border-radius:50%;background:var(--red-dim);border:1px solid var(--red);display:flex;align-items:center;justify-content:center;font-size:26px;margin:0 auto 14px;animation:pulseDanger 1.6s ease-in-out infinite}
.discipline-title{font-family:var(--font-d);font-weight:800;font-size:1.15rem;color:var(--red);letter-spacing:-.3px;margin-bottom:8px}
.discipline-msg{font-family:var(--font-r);font-size:14px;color:var(--text2);line-height:1.55;margin-bottom:16px}
.discipline-stats{display:flex;justify-content:center;gap:10px;margin-bottom:18px;flex-wrap:wrap}
.discipline-stat{background:var(--surface3);border:1px solid var(--border2);border-radius:10px;padding:8px 14px;min-width:84px}
.discipline-stat .n{font-family:var(--font-d);font-weight:800;font-size:1.05rem}
.discipline-stat .l{font-size:8.5px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:2px;font-family:var(--font-r)}
.discipline-actions{display:flex;flex-direction:column;gap:8px}
.btn-discipline-lock{background:linear-gradient(135deg,var(--red),var(--amber));color:#fff;border:none;border-radius:var(--radius);padding:11px 16px;font-family:var(--font-r);font-weight:700;font-size:13.5px;cursor:pointer;letter-spacing:.3px;box-shadow:0 4px 20px rgba(244,63,94,.35)}
.btn-discipline-lock:hover{transform:translateY(-1px)}
.btn-discipline-ack{background:none;border:1px solid var(--border2);color:var(--muted);border-radius:var(--radius);padding:9px 16px;font-family:var(--font-r);font-weight:600;font-size:12.5px;cursor:pointer}
.btn-discipline-ack:hover{color:var(--text);border-color:var(--border3)}

.lock-banner{background:linear-gradient(135deg,rgba(244,63,94,0.1),rgba(251,146,60,0.06));border:1px solid var(--red);border-radius:var(--radius-lg);padding:14px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:10px}
.lock-banner-text{font-family:var(--font-r);font-size:12.5px;color:var(--red);font-weight:600;line-height:1.5}
.lock-banner-text b{color:var(--text)}
.btn-unlock{background:none;border:1px solid var(--border2);color:var(--muted);border-radius:8px;padding:6px 12px;font-family:var(--font-r);font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap}
.btn-unlock:hover{color:var(--red);border-color:var(--red)}

.perf-table{width:100%;border-collapse:collapse;font-size:12px}
.perf-table th{font-size:8.5px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;padding:6px 8px;border-bottom:1px solid var(--border);text-align:left;font-family:var(--font-r);font-weight:700}
.perf-table td{padding:7px 8px;border-bottom:1px solid var(--border);font-family:var(--font-m)}
.perf-table tr:last-child td{border-bottom:none}
.perf-table .pf-name{font-family:var(--font-r);font-weight:600;color:var(--text)}
.perf-table .pf-best{color:var(--green)}.perf-table .pf-worst{color:var(--red)}
.insight-banner{display:flex;align-items:flex-start;gap:10px;background:var(--accent2-dim);border:1px solid var(--border3);border-radius:var(--radius-lg);padding:12px 14px;margin-bottom:14px;font-family:var(--font-r);font-size:12.5px;color:var(--text2);line-height:1.55}
.insight-banner .ic{font-size:16px;flex-shrink:0}
.fee-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px}
.fee-stat{background:var(--surface3);border:1px solid var(--border2);border-radius:10px;padding:10px 12px}
.fee-stat .fv{font-family:var(--font-d);font-weight:800;font-size:1.05rem}
.fee-stat .fl{font-size:8.5px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:3px;font-family:var(--font-r)}

/* ── YESTERDAY VS TODAY ── */
.yt-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:900px){.yt-grid{grid-template-columns:1fr}}
.yt-card{background:var(--surface3);border:1px solid var(--border2);border-radius:var(--radius-lg);padding:14px 16px;position:relative;overflow:hidden}
.yt-card.is-today{border-color:rgba(0,212,255,0.35)}
.yt-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;flex-wrap:wrap;gap:6px}
.yt-title{font-family:var(--font-d);font-weight:800;font-size:1rem;letter-spacing:-.2px;color:var(--text)}
.yt-title span{color:var(--accent)}
.yt-date{font-family:var(--font-m);font-size:10.5px;color:var(--muted)}
.yt-day{font-family:var(--font-r);font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px}
.yt-net{font-family:var(--font-d);font-weight:800;font-size:1.15rem;margin-bottom:2px}
.yt-net.up{color:var(--green)}.yt-net.down{color:var(--red)}.yt-net.flat{color:var(--text2)}
.yt-sub{font-size:10.5px;color:var(--muted);font-family:var(--font-m);margin-bottom:10px}
.yt-upside-label{font-size:9px;color:var(--green);text-transform:uppercase;letter-spacing:1.2px;font-family:var(--font-r);font-weight:700;margin-bottom:6px;display:flex;align-items:center;gap:5px}
.yt-tx{display:flex;flex-direction:column;gap:6px;max-height:190px;overflow-y:auto}
.yt-tx-row{display:flex;align-items:center;justify-content:space-between;gap:8px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:6px 9px;font-size:11.5px}
.yt-tx-left{display:flex;align-items:center;gap:7px;min-width:0}
.yt-tx-sym{font-family:var(--font-r);font-weight:700;color:var(--text);white-space:nowrap}
.yt-tx-time{font-family:var(--font-m);font-size:10px;color:var(--muted);white-space:nowrap}
.yt-tx-pnl{font-family:var(--font-d);font-weight:800;color:var(--green);white-space:nowrap}
.yt-empty{font-size:11px;color:var(--muted);font-family:var(--font-r);padding:8px 0}

/* ── DAY TITLE ROWS IN TRADE HISTORY ── */
tr.day-header-row td{padding:0;border-bottom:none}
tr.day-header-row:not(:first-child) td{padding-top:10px}
.day-header{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;background:linear-gradient(135deg,rgba(124,58,255,0.1),rgba(0,212,255,0.05));border:1px solid var(--border3);border-radius:10px;padding:8px 14px;margin-bottom:2px}
.day-header-left{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap}
.day-title{font-family:var(--font-d);font-weight:800;font-size:13px;color:var(--text);letter-spacing:-.2px}
.day-name{font-family:var(--font-r);font-size:10.5px;color:var(--accent);text-transform:uppercase;letter-spacing:1.2px;font-weight:700}
.day-header-right{display:flex;align-items:center;gap:12px}
.day-count{font-family:var(--font-m);font-size:10.5px;color:var(--muted)}
.day-net{font-family:var(--font-d);font-weight:800;font-size:13px}
.day-net.pnl-pos{color:var(--green)}.day-net.pnl-neg{color:var(--red)}

/* ── SCREENSHOTS ── */
.screenshot-zone{border:1px dashed var(--border2);border-radius:var(--radius-lg);padding:14px;margin-top:12px;display:flex;gap:12px;flex-wrap:wrap;align-items:flex-start;background:rgba(0,0,0,0.2)}
.ss-slot{position:relative;flex:1;min-width:140px;max-width:240px}
.ss-slot label{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:1.2px;display:block;margin-bottom:6px;font-family:var(--font-r);font-weight:700}
.ss-slot input[type=file]{display:none}
.ss-preview{width:100%;height:100px;background:var(--surface3);border:1px solid var(--border);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:11px;cursor:pointer;overflow:hidden;transition:all .2s;position:relative}
.ss-preview:hover{border-color:var(--accent2);box-shadow:0 0 20px rgba(124,58,255,0.15)}
.ss-preview img{width:100%;height:100%;object-fit:cover;border-radius:10px}
.ss-paste-hint{font-size:9px;color:var(--muted);margin-top:4px;text-align:center}
.ss-remove{position:absolute;top:22px;right:4px;background:var(--red);border:none;border-radius:4px;color:#fff;font-size:10px;cursor:pointer;padding:2px 5px;display:none;z-index:2}
.ss-preview.dragover{border-color:var(--accent2);background:var(--accent2-dim)}

/* ── TRADE TABLE ── */
.table-wrap{background:linear-gradient(135deg,var(--surface) 0%,var(--surface2) 100%);border:1px solid var(--border);border-radius:var(--radius-xl);overflow:hidden;margin-bottom:1.5rem}
.table-header{display:flex;align-items:center;justify-content:space-between;padding:.9rem 1.4rem;border-bottom:1px solid var(--border);flex-wrap:wrap;gap:10px;background:rgba(0,0,0,0.2)}
.table-title{font-family:var(--font-d);font-size:.95rem;font-weight:800;letter-spacing:-.3px;color:var(--text)}
.filter-row{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.filter-row select,.filter-row input{background:var(--surface3);border:1px solid var(--border2);border-radius:8px;color:var(--text);font-family:var(--font-m);font-size:11.5px;padding:5px 9px;outline:none;transition:all .15s}
.filter-row select:focus,.filter-row input:focus{border-color:var(--accent)}
.tbl{width:100%;border-collapse:collapse}
.tbl th{text-align:left;padding:9px 11px;font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;border-bottom:1px solid var(--border);white-space:nowrap;font-family:var(--font-r);font-weight:700}
.tbl td{padding:10px 11px;font-size:12px;border-bottom:1px solid var(--border);vertical-align:middle}
.tbl tr:last-child td{border-bottom:none}
.tbl tr:hover td{background:rgba(99,120,255,0.04)}
.tbl tr.editing td{background:rgba(0,212,255,0.04)!important}
.tbl tr.editing td input,.tbl tr.editing td select{background:var(--surface3);border:1px solid var(--accent);border-radius:6px;color:var(--text);font-family:var(--font-m);font-size:11px;padding:3px 6px;width:100%;outline:none;min-width:60px}

/* ── CHIPS ── */
.chip{display:inline-block;font-size:9.5px;padding:2px 9px;border-radius:20px;font-weight:700;font-family:var(--font-r);letter-spacing:.5px}
.chip.long{background:rgba(0,212,255,0.12);color:var(--accent);border:1px solid rgba(0,212,255,0.2)}
.chip.short{background:var(--red-dim);color:var(--red);border:1px solid rgba(244,63,94,0.2)}
.chip.win{background:rgba(16,185,129,0.12);color:var(--green);border:1px solid rgba(16,185,129,0.2)}
.chip.loss{background:var(--red-dim);color:var(--red);border:1px solid rgba(244,63,94,0.2)}
.chip.be{background:var(--amber-dim);color:var(--amber);border:1px solid rgba(251,146,60,0.2)}
.pnl-pos{color:var(--green);font-weight:600}.pnl-neg{color:var(--red);font-weight:600}
.action-btn{background:none;border:none;color:var(--muted);cursor:pointer;font-size:13px;padding:4px 7px;border-radius:7px;transition:all .15s;line-height:1}
.action-btn.del:hover{color:var(--red);background:var(--red-dim)}
.action-btn.edt:hover{color:var(--accent);background:var(--accent-dim)}
.action-btn.sav{color:var(--green)}.action-btn.sav:hover{background:var(--green-dim)}
.action-btn.cnc{color:var(--amber)}.action-btn.cnc:hover{background:var(--amber-dim)}
.ss-thumb{width:30px;height:21px;object-fit:cover;border-radius:4px;border:1px solid var(--border);cursor:pointer;vertical-align:middle;transition:all .15s}
.ss-thumb:hover{transform:scale(1.15);border-color:var(--accent)}
.summary-row td{font-weight:700;background:rgba(124,58,255,0.06)!important;border-top:1px solid var(--border3)}
.dur-chip{display:inline-block;font-size:9.5px;padding:2px 7px;border-radius:10px;background:var(--amber-dim);color:var(--amber);font-family:var(--font-r);font-weight:600;border:1px solid rgba(251,146,60,0.2)}

/* ── ANALYTICS ── */
.analytics-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:1.5rem}
@media(max-width:700px){.analytics-grid{grid-template-columns:1fr}}
.analytics-card{background:linear-gradient(135deg,var(--surface) 0%,var(--surface2) 100%);border:1px solid var(--border);border-radius:var(--radius-xl);padding:1.3rem 1.5rem}
.a-title{font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:1rem;font-family:var(--font-r);font-weight:700}
.bar-row{display:flex;align-items:center;gap:10px;margin-bottom:9px}
.bar-label{font-size:11px;color:var(--text2);width:80px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:var(--font-r)}
.bar-track{flex:1;height:4px;background:var(--surface3);border-radius:3px;overflow:hidden}
.bar-fill{height:100%;border-radius:3px;transition:width .5s cubic-bezier(.4,0,.2,1)}
.bar-val{font-size:11px;color:var(--text);width:70px;text-align:right;font-weight:600;font-family:var(--font-m)}
.chart-card{background:linear-gradient(135deg,var(--surface) 0%,var(--surface2) 100%);border:1px solid var(--border);border-radius:var(--radius-xl);padding:1.4rem 1.8rem;margin-bottom:1.4rem}
.chart-title{font-family:var(--font-d);font-size:.95rem;font-weight:800;margin-bottom:1.1rem;display:flex;align-items:center;justify-content:space-between;letter-spacing:-.3px}
canvas{width:100%!important}
.empty{text-align:center;padding:3rem 1rem;color:var(--muted)}
.empty-icon{font-size:2.5rem;margin-bottom:.9rem}
.empty h3{font-family:var(--font-d);color:var(--text2);margin-bottom:6px;font-size:1.1rem}
.overall-bar{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:12px;margin-bottom:1.6rem}
@media(max-width:700px){.overall-bar{grid-template-columns:1fr 1fr}}
.ov-card{background:linear-gradient(135deg,var(--surface2),var(--surface3));border:1px solid var(--border);border-radius:var(--radius-xl);padding:1rem 1.2rem;text-align:center}
.ov-label{font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:1.2px;margin-bottom:6px;font-family:var(--font-r);font-weight:600}
.ov-val{font-family:var(--font-d);font-size:1.35rem;font-weight:800;letter-spacing:-.5px}

/* ── MODALS ── */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.85);backdrop-filter:blur(8px);z-index:200;align-items:center;justify-content:center;padding:20px}
.modal-overlay.open{display:flex}
.modal{background:linear-gradient(135deg,var(--surface) 0%,var(--surface2) 100%);border:1px solid var(--border2);border-radius:var(--radius-xl);padding:1.5rem;max-width:92vw;max-height:92vh;overflow:auto;position:relative}
.modal img{max-width:78vw;max-height:78vh;border-radius:10px;display:block}
.modal-close{position:absolute;top:12px;right:14px;background:var(--red-dim);border:1px solid var(--red);color:var(--red);border-radius:8px;padding:4px 12px;cursor:pointer;font-size:12px;font-family:var(--font-r);font-weight:700;transition:all .15s}
.modal-close:hover{background:var(--red);color:#fff}
.modal-ss-wrap{display:flex;gap:16px;flex-wrap:wrap}
.modal-ss-item{text-align:center}
.modal-ss-item p{font-size:10px;color:var(--muted);margin-bottom:6px;text-transform:uppercase;letter-spacing:1px;font-family:var(--font-r)}
.edit-modal{background:linear-gradient(135deg,var(--surface) 0%,var(--surface2) 100%);border:1px solid var(--border2);border-radius:var(--radius-xl);padding:1.8rem;width:min(96vw,640px);max-height:92vh;overflow-y:auto;position:relative}
.edit-modal .form-grid{grid-template-columns:repeat(auto-fit,minmax(140px,1fr))}

/* ── TOAST ── */
#toast{position:fixed;bottom:24px;right:24px;background:linear-gradient(135deg,var(--accent2),var(--accent));color:#fff;padding:10px 20px;border-radius:12px;font-size:12.5px;font-weight:600;font-family:var(--font-r);letter-spacing:.5px;transform:translateY(80px);opacity:0;transition:all .3s cubic-bezier(.4,0,.2,1);z-index:999;box-shadow:0 8px 30px rgba(124,58,255,0.4)}
#toast.show{transform:translateY(0);opacity:1}

/* ── AI BUTTON ── */
.btn-ai{background:linear-gradient(135deg,rgba(124,58,255,0.2),rgba(0,212,255,0.15));border:1px solid rgba(124,58,255,0.5);color:var(--text);border-radius:10px;padding:6px 16px;font-family:var(--font-r);font-size:13px;font-weight:700;cursor:pointer;transition:all .2s;letter-spacing:.5px;position:relative}
.btn-ai:hover{background:linear-gradient(135deg,var(--accent2),rgba(0,212,255,0.8));color:#fff;box-shadow:0 4px 20px rgba(124,58,255,0.4)}
.btn-ai .ai-dot{position:absolute;top:5px;right:6px;width:7px;height:7px;background:#10b981;border-radius:50%;animation:pulse-dot 2s infinite}
@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.6;transform:scale(1.3)}}

/* ── AI CHAT PANEL ── */
#ai-panel{position:fixed;bottom:24px;right:24px;width:380px;max-height:600px;background:linear-gradient(160deg,#0e1220 0%,#131829 100%);border:1px solid rgba(124,58,255,0.35);border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,0.7),0 0 40px rgba(124,58,255,0.12);z-index:500;display:none;flex-direction:column;overflow:hidden;font-family:var(--font-m)}
#ai-panel.open{display:flex;animation:slideUp .25s cubic-bezier(.4,0,.2,1)}
@keyframes slideUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.ai-header{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid rgba(124,58,255,0.2);background:rgba(124,58,255,0.08);flex-shrink:0}
.ai-avatar{width:36px;height:36px;background:linear-gradient(135deg,#7c3aff,#00d4ff);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0}
.ai-title-wrap{flex:1}
.ai-title{font-family:var(--font-r);font-weight:700;font-size:13px;color:var(--text);letter-spacing:.5px}
.ai-subtitle{font-size:9px;color:var(--muted);letter-spacing:1px;text-transform:uppercase;margin-top:1px}
.ai-close{background:none;border:none;color:var(--muted);cursor:pointer;font-size:18px;line-height:1;padding:2px 5px;border-radius:5px;transition:all .15s}
.ai-close:hover{color:var(--red);background:var(--red-dim)}
.ai-messages{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:12px;min-height:200px;max-height:400px}
.ai-msg{display:flex;gap:9px;align-items:flex-start}
.ai-msg.user{flex-direction:row-reverse}
.ai-bubble{max-width:88%;padding:10px 14px;border-radius:14px;font-size:12px;line-height:1.6;word-break:break-word}
.ai-msg.bot .ai-bubble{background:rgba(124,58,255,0.12);border:1px solid rgba(124,58,255,0.2);color:var(--text);border-radius:4px 14px 14px 14px}
.ai-msg.user .ai-bubble{background:linear-gradient(135deg,var(--accent2),rgba(0,212,255,0.8));color:#fff;border-radius:14px 4px 14px 14px}
.ai-msg-avatar{width:26px;height:26px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;margin-top:2px}
.ai-msg.bot .ai-msg-avatar{background:linear-gradient(135deg,#7c3aff,#00d4ff)}
.ai-msg.user .ai-msg-avatar{background:var(--surface3);border:1px solid var(--border2)}
.ai-typing{display:flex;gap:4px;align-items:center;padding:10px 14px}
.ai-typing span{width:6px;height:6px;background:var(--accent2);border-radius:50%;animation:bounce 1.2s infinite}
.ai-typing span:nth-child(2){animation-delay:.2s}
.ai-typing span:nth-child(3){animation-delay:.4s}
@keyframes bounce{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-6px)}}
.ai-quick-btns{display:flex;gap:6px;flex-wrap:wrap;padding:0 14px 10px}
.ai-quick-btn{background:rgba(124,58,255,0.1);border:1px solid rgba(124,58,255,0.25);color:var(--text2);border-radius:20px;padding:4px 11px;font-size:10.5px;cursor:pointer;font-family:var(--font-r);font-weight:600;letter-spacing:.3px;transition:all .15s;white-space:nowrap}
.ai-quick-btn:hover{background:var(--accent2);color:#fff;border-color:var(--accent2)}
.ai-input-row{display:flex;gap:8px;padding:12px 14px;border-top:1px solid rgba(124,58,255,0.15);background:rgba(0,0,0,0.2);flex-shrink:0}
.ai-input{flex:1;background:rgba(255,255,255,0.05);border:1px solid var(--border2);border-radius:10px;color:var(--text);font-family:var(--font-m);font-size:12px;padding:8px 12px;outline:none;transition:all .2s;resize:none}
.ai-input:focus{border-color:var(--accent2);box-shadow:0 0 0 3px rgba(124,58,255,0.1)}
.ai-send{background:linear-gradient(135deg,var(--accent2),var(--accent));border:none;border-radius:10px;color:#fff;cursor:pointer;padding:8px 14px;font-size:14px;transition:all .2s;flex-shrink:0}
.ai-send:hover{transform:scale(1.05);box-shadow:0 4px 15px rgba(124,58,255,0.4)}
.ai-send:disabled{opacity:.4;transform:none;cursor:not-allowed}

/* ── CALENDAR ── */
.cal-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.4rem;flex-wrap:wrap;gap:10px}
.cal-nav-title{font-family:var(--font-d);font-size:1.35rem;font-weight:800;color:var(--text);letter-spacing:-.5px}
.cal-nav-btns{display:flex;gap:8px}
.cal-nav-btn{background:var(--surface3);border:1px solid var(--border2);color:var(--text2);border-radius:10px;padding:7px 18px;font-family:var(--font-r);font-size:13px;font-weight:700;cursor:pointer;transition:all .2s;letter-spacing:.5px}
.cal-nav-btn:hover{background:var(--surface4);border-color:var(--border3);color:var(--text)}
.cal-today-btn{background:linear-gradient(135deg,var(--accent2),var(--accent));border:none;color:#fff;border-radius:10px;padding:7px 18px;font-family:var(--font-r);font-size:13px;font-weight:700;cursor:pointer;letter-spacing:.5px;box-shadow:0 2px 12px rgba(124,58,255,.35)}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;background:var(--border);border-radius:var(--radius-xl);overflow:hidden;border:1px solid var(--border)}
.cal-header-cell{background:var(--surface2);padding:8px 4px;text-align:center;font-size:10px;color:var(--muted);font-family:var(--font-r);font-weight:700;letter-spacing:1px;text-transform:uppercase}
.cal-cell{background:var(--surface);min-height:88px;padding:6px;cursor:default;transition:all .2s;position:relative;border:1px solid transparent;display:flex;flex-direction:column;gap:3px}
.cal-cell.has-trades{cursor:pointer}
.cal-cell.has-trades:hover{background:var(--surface3);border-color:var(--border2);transform:scale(1.01);z-index:2}
.cal-cell.today .cal-date-num{background:linear-gradient(135deg,var(--accent2),var(--accent));color:#fff;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800}
.cal-cell.other-month{opacity:.35}
.cal-date-num{font-family:var(--font-d);font-size:13px;font-weight:700;color:var(--text2);line-height:1;display:flex;align-items:center;justify-content:center;width:24px;height:24px}
.cal-pnl-badge{font-size:11px;font-weight:700;font-family:var(--font-m);padding:2px 6px;border-radius:6px;text-align:center;line-height:1.3}
.cal-pnl-badge.profit{background:rgba(16,185,129,.15);color:var(--green);border:1px solid rgba(16,185,129,.25)}
.cal-pnl-badge.loss{background:rgba(244,63,94,.13);color:var(--red);border:1px solid rgba(244,63,94,.2)}
.cal-pnl-badge.be{background:var(--amber-dim);color:var(--amber);border:1px solid rgba(251,146,60,.25)}
.cal-meta{font-size:9px;color:var(--muted);font-family:var(--font-r);font-weight:600;letter-spacing:.3px;line-height:1.2}
.cal-strat-tag{font-size:9px;color:var(--accent2);font-family:var(--font-r);font-weight:600;letter-spacing:.2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%}
.cal-legend{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:1.1rem;align-items:center}
.cal-legend-item{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--text2);font-family:var(--font-r);font-weight:600}
.cal-legend-dot{width:10px;height:10px;border-radius:3px}

/* ── CALENDAR POPUP ── */
.cal-popup-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(6px);z-index:300;align-items:center;justify-content:center;padding:20px}
.cal-popup-overlay.open{display:flex;animation:fadeUp .2s ease}
.cal-popup{background:linear-gradient(135deg,var(--surface) 0%,var(--surface2) 100%);border:1px solid var(--border2);border-radius:var(--radius-xl);padding:1.6rem;width:min(95vw,560px);max-height:90vh;overflow-y:auto;position:relative}
.cal-popup-date{font-family:var(--font-d);font-size:1.1rem;font-weight:800;color:var(--accent);margin-bottom:1.1rem;letter-spacing:-.3px}
.cal-popup-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:1.2rem}
.cal-popup-stat{background:var(--surface3);border:1px solid var(--border);border-radius:var(--radius);padding:.7rem .8rem;text-align:center}
.cal-popup-stat-label{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;font-family:var(--font-r);font-weight:700;margin-bottom:4px}
.cal-popup-stat-val{font-family:var(--font-d);font-size:1.1rem;font-weight:800}
.cal-trade-card{background:var(--surface3);border:1px solid var(--border);border-radius:var(--radius);padding:.9rem 1rem;margin-bottom:.7rem}
.cal-trade-card:last-child{margin-bottom:0}
.cal-trade-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;flex-wrap:wrap;gap:6px}
.cal-trade-sym{font-family:var(--font-d);font-size:.95rem;font-weight:800;color:var(--text)}
.cal-trade-row{display:flex;gap:12px;flex-wrap:wrap;font-size:11px;color:var(--text2);font-family:var(--font-r);font-weight:600}
.cal-trade-row span{display:flex;align-items:center;gap:3px}
.cal-popup-close{position:absolute;top:14px;right:16px;background:var(--red-dim);border:1px solid var(--red);color:var(--red);border-radius:8px;padding:4px 12px;cursor:pointer;font-size:12px;font-family:var(--font-r);font-weight:700;transition:all .15s}
.cal-popup-close:hover{background:var(--red);color:#fff}

/* ── SCROLLBAR ── */
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:var(--surface)}
::-webkit-scrollbar-thumb{background:var(--border3);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--accent2)}

@media(max-width:600px){main{padding:1rem}.form-grid{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>

<header>
  <div class="logo-wrap">
    <!-- Dharun Records Logo SVG -->
    <svg class="logo-icon" viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="lg1" x1="0" y1="0" x2="38" y2="38" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#7c3aff"/>
          <stop offset="100%" stop-color="#00d4ff"/>
        </linearGradient>
        <linearGradient id="lg2" x1="0" y1="38" x2="38" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#00d4ff" stop-opacity=".6"/>
          <stop offset="100%" stop-color="#7c3aff" stop-opacity=".2"/>
        </linearGradient>
      </defs>
      <!-- Outer ring -->
      <circle cx="19" cy="19" r="18" stroke="url(#lg1)" stroke-width="1.5" fill="rgba(124,58,255,0.08)"/>
      <!-- Chart bars rising -->
      <rect x="7" y="22" width="4" height="8" rx="1.5" fill="url(#lg1)" opacity=".7"/>
      <rect x="13" y="17" width="4" height="13" rx="1.5" fill="url(#lg1)" opacity=".85"/>
      <rect x="19" y="12" width="4" height="18" rx="1.5" fill="url(#lg1)"/>
      <rect x="25" y="8" width="4" height="22" rx="1.5" fill="url(#lg1)"/>
      <!-- Top glow dot -->
      <circle cx="27" cy="7" r="2.5" fill="#00d4ff" opacity=".9"/>
      <!-- Trend line -->
      <polyline points="9,28 15,22 21,17 27,8" stroke="url(#lg1)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity=".5"/>
    </svg>
    <div class="logo-text">
      <div class="logo-name">DHARUN <span>RECORDS</span></div>
      <div class="logo-sub">Trading Journal</div>
    </div>
  </div>
  <nav>
    <button class="active" onclick="switchView('journal',this)">Journal</button>
    <button onclick="switchView('analytics',this)">Analytics</button>
    <button onclick="switchView('equity',this)">Equity</button>
    <button onclick="switchView('calendar',this)">📅 Calendar</button>
  </nav>
  <div class="hdr-right">
    <span class="badge mood-badge" id="mood-badge" title="Auto-theme based on your recent PnL and emotion tags">◈ Neutral</span>
    <span class="badge" id="total-badge">0 trades</span>
    <button class="btn-ai" onclick="toggleAI()">🤖 AI Advisor</button>
    <button class="btn-pdf" onclick="downloadPDF()">⬇ PDF Report</button>
  </div>
</header>

<main>
  <!-- Always-visible stats -->
  <div class="stats-grid">
