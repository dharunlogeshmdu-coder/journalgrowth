function fmtINR(n){
  const abs=Math.abs(n);
  return (n<0?'-':'')+'₹'+abs.toLocaleString('en-IN',{maximumFractionDigits:2});
}
function fmtSgn(n){ return (n>=0?'+':'')+fmtINR(n); }
