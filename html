function ymd(d){ return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
function renderYesterdayToday(){
  const grid = document.getElementById('yt-compare-grid');
  if(!grid) return;
  const charge = brokerCharge();
  const now = new Date();
  const todayStr = ymd(now);
  const yest = new Date(now); yest.setDate(yest.getDate()-1);
  const yestStr = ymd(yest);
  const dayNameFmt = d => d.toLocaleDateString('en-IN',{weekday:'long'});
  const dateFmt = d => d.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'});

  function buildCard(label, dateObj, dateStr, isToday){
    const dayTrades = trades.filter(t=>t.date===dateStr).sort((a,b)=>(a.entryTime||'').localeCompare(b.entryTime||''));
    const gross = dayTrades.reduce((s,t)=>s+t.pnl,0);
    const net = gross - dayTrades.length*charge;
    const upside = dayTrades.filter(t=>t.pnl>0).sort((a,b)=>b.pnl-a.pnl);
    const netClass = net>0?'up':net<0?'down':'flat';

    const txHtml = upside.length ? upside.map(t=>`
      <div class="yt-tx-row">
        <div class="yt-tx-left">
          <span class="chip ${t.direction==='Long'?'long':'short'}">${t.direction}</span>
          <span class="yt-tx-sym">${t.symbol||''}</span>
          <span class="yt-tx-time">${t.entryTime||''}${t.exitTime?'–'+t.exitTime:''}</span>
        </div>
        <div class="yt-tx-pnl">${fmtSgn(t.pnl)}</div>
      </div>`).join('') : `<div class="yt-empty">No upside (winning) trades ${dayTrades.length?'on this day':'recorded'}.</div>`;

    return `
      <div class="yt-card ${isToday?'is-today':''}">
        <div class="yt-head">
          <div class="yt-title">${isToday?'<span>Today</span>':'Yesterday'}</div>
          <div class="yt-date">${dateFmt(dateObj)}</div>
        </div>
        <div class="yt-day">${dayNameFmt(dateObj)}</div>
        <div class="yt-net ${netClass}">${fmtSgn(net)}</div>
        <div class="yt-sub">${dayTrades.length} trade${dayTrades.length===1?'':'s'} · ${upside.length} upside</div>
        <div class="yt-upside-label">▲ Upside transactions</div>
        <div class="yt-tx">${txHtml}</div>
      </div>`;
  }

  grid.innerHTML = buildCard('Yesterday', yest, yestStr, false) + buildCard('Today', now, todayStr, true);
}
